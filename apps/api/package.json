{
  "name": "@hrforce/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker": "tsc -p tsconfig.build.json && node dist/worker.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "migrate": "tsc -p tsconfig.build.json && node dist/platform/db/migrate.js",
    "seed:dev": "tsc -p tsconfig.build.json && node dist/scripts/seed-dev.js",
    "user:invite": "tsc -p tsconfig.build.json && node dist/scripts/user-invite.js",
    "bootstrap": "tsc -p tsconfig.build.json && node dist/scripts/bootstrap.js",
    "oidc:keys": "tsc -p tsconfig.build.json && node dist/scripts/oidc-keys.js",
    "db:codegen": "kysely-codegen",
    "db:codegen:verify": "kysely-codegen --verify"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "kysely-codegen": "0.20.0",
    "openid-client": "6.8.8",
    "supertest": "7.3.0",
    "typescript": "7.0.2",
    "unpdf": "1.8.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@node-rs/argon2": "2.2.1",
    "cookie-parser": "1.4.7",
    "graphile-worker": "0.18.0",
    "kysely": "0.29.6",
    "nestjs-pino": "5.2.0",
    "nodemailer": "10.0.10",
    "oidc-provider": "9.12.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
