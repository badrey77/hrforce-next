# Edge proxy for staging (service `proxy` in compose.staging.yml; image caddy:2.10-alpine).
#  - automatic HTTPS (Let's Encrypt) for {$STAGING_DOMAIN}; HTTP → HTTPS redirect is automatic
#  - /api and /api/* → api:3000 (the NestJS API); everything else → web:8080 (static Angular build, SPA fallback)
#  - security headers on every response, API included
# Upstream names resolve on the compose-internal network only; neither api nor web publishes a port.
{
	email {$ACME_EMAIL}
}

{$STAGING_DOMAIN} {
	# Compression buffers responses, which would hold back Server-Sent Events: never compress the notification stream.
	@compressible not path /api/me/notifications/stream
	encode @compressible zstd gzip

	# Access log on stdout (docker compose logs proxy). /password/setup?token=… carries a live single-use token in
	# its query: drop it from the log. Cookie / Authorization headers are redacted by Caddy by default.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
			}
		}
	}

	header {
		# Removing a header makes Caddy apply the whole block lazily, i.e. these values also override anything
		# the upstreams send.
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow"
		# Scripts: only our own files (no inline script, no eval). Styles: 'unsafe-inline' is required because
		# Angular injects component styles as <style> elements at runtime (no per-request nonce with a static
		# server). Fonts are self-hosted (Cairo, Source Sans 3). The index.html build output must contain no inline
		# <script> / on* handler: apps/web/Dockerfile fails the build otherwise (deploy/web/check-index-csp.mjs).
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
	}

	@api path /api /api/*
	handle @api {
		# Defence in depth: the development identity headers never reach the API (DEV_AUTH is also refused in
		# production by the API's env validation).
		request_header -X-Dev-User-Id
		request_header -X-Dev-Company-Id
		# Caddy replaces any client-sent X-Forwarded-For with the real client IP (no trusted_proxies configured),
		# so the API's TRUST_PROXY_HOPS=1 yields the true client address for the login throttle.
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:8080
	}
}
