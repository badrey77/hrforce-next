# HRForce staging — copy to deploy/.env on the server (./init-env.sh does it and fills every secret), then edit the
# values marked EDIT. Keep it private: chmod 600, never commit it (git-ignored).
# Compose reads this file for ${VAR} substitution only; compose.staging.yml hands each container just the
# variables it needs (the API never sees the migrator or superuser password).

# ---- Compose ------------------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=hrforce-staging
COMPOSE_FILE=compose.staging.yml
# Image repository prefix: ghcr.io/<github owner, lower case>. Images: <prefix>/hrforce-api, <prefix>/hrforce-web.
HRFORCE_REGISTRY=ghcr.io/badrey77
# Git SHA of the running release. Written by deploy.sh after a successful deploy — do not edit by hand;
# roll back with ./deploy.sh <older-sha>.
HRFORCE_TAG=

# ---- Public endpoint ----------------------------------------------------------------------------------------
# EDIT. DNS A (and AAAA if any) record → this server. Caddy gets the Let's Encrypt certificate for it.
# The API's WEB_BASE_URL (mailed links) is https://${STAGING_DOMAIN}.
STAGING_DOMAIN=staging.hrforce.example.dz
# EDIT. Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.dz

# ---- Database passwords -------------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Hex on purpose: these are embedded in postgres:// URLs, where base64's + / = would need escaping.
# Used on the FIRST start only to create the roles (apps/api/scripts/create-roles.sql); changing them later
# needs the procedure in README.md › Rotate secrets.
# Superuser `postgres`: used by the init hook and the backup job only.
POSTGRES_SUPERUSER_PASSWORD=
# hrforce_migrator: owns the schema; used by the migrate job, user:invite and the optional demo seed.
HRFORCE_MIGRATOR_PASSWORD=
# hrforce_app: the API's runtime role (DML only, subject to row-level security).
HRFORCE_APP_PASSWORD=
# hrforce_worker: the background worker's role (jobs and cron; subject to row-level security). An existing
# install gets it on the next ./deploy.sh (create-roles.sql is re-applied): add a value here first
# (openssl rand -hex 32).
HRFORCE_WORKER_PASSWORD=

# ---- API secrets (each ≥ 32 characters, all different) ----------------------------------------------------
# Generate each with: openssl rand -base64 48
# Rotating COOKIE_SECRET / AUTH_ACCESS_SECRET / AUTH_XSRF_SECRET signs everyone out (no data loss).
# cookie-parser secret
COOKIE_SECRET=
# HS256 key of the access token (cookie hrf_at)
AUTH_ACCESS_SECRET=
# HMAC key of the double-submit XSRF token (cookie XSRF-TOKEN); must differ from AUTH_ACCESS_SECRET
AUTH_XSRF_SECRET=

# Two-step sign-in: AES-256-GCM key of the users' TOTP secrets — base64 of exactly 32 bytes
# (openssl rand -base64 32). NEVER rotate it casually: a new key makes every enrolled authenticator unusable (each user
# then needs an admin reset). Back it up with the database backups' key material, separately from the dumps.
AUTH_MFA_KEY=

# Attendance check-in (docs/contracts/attendance.md, ADR 009): HMAC key of the kiosks' rotating QR codes, the phones'
# scan receipts and the per-browser device references — base64 of exactly 32 bytes (openssl rand -base64 32).
# Rotating it only invalidates the codes on screen (≤ 2 min) and the pending scans (≤ 5 min).
ATTENDANCE_KEY=

# ---- Mail (external SMTP relay; no mail server runs on this host) ------------------------------------------
# EDIT. smtp://user:password@host:587 (STARTTLS) or smtps://user:password@host:465. Percent-encode special
# characters of the user/password (@ → %40, : → %3A, / → %2F …).
SMTP_URL=smtps://user:password@smtp.example.dz:465
# EDIT. From header of password setup / reset mails and notification e-mails (sent by the worker).
MAIL_FROM=HRForce staging <no-reply@example.dz>

# ---- Tuning (defaults are fine) ----------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
DB_POOL_MAX=10
# Background jobs run at the same time by the worker (1–32).
WORKER_CONCURRENCY=4
# Nightly backup time, HH:MM in UTC (01:30 UTC = 02:30 in Algiers), and how many days of dumps to keep.
BACKUP_TIME_UTC=01:30
BACKUP_RETENTION_DAYS=14

# Never set here (the API refuses them in production, and compose.staging.yml does not pass them):
# DEV_AUTH, DEV_PERMISSIONS, MAIL_TRANSPORT=log, COOKIE_SECURE=false.
