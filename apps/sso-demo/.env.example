# SSO demo sister app (docs/contracts/sso.md › Demo sister app). Copy to .env (git-ignored); scripts/dev-up.* do it.
# Every variable is validated at boot (src/env.ts); a missing or invalid value stops the app (exit 1).
NODE_ENV=development
SSO_DEMO_PORT=4300
# Public URL of this app: the redirect URI is ${SSO_DEMO_BASE_URL}/callback, the post-logout URI ${SSO_DEMO_BASE_URL}/signed-out
SSO_DEMO_BASE_URL=http://localhost:4300
# HRForce issuer = ${WEB_BASE_URL}/oidc. http:// is accepted only when NODE_ENV is not production.
SSO_DEMO_ISSUER=http://localhost:4200/oidc
SSO_DEMO_CLIENT_ID=sso-demo
# DEVELOPMENT ONLY — INSECURE, PUBLIC VALUE. It matches the client `sso-demo` created by `npm run seed:dev -w @hrforce/api`
# (DEMO company). It is refused when NODE_ENV=production. For a real install, register the app in HRForce
# (Access → Applications) and paste the secret shown once here.
SSO_DEMO_CLIENT_SECRET=sso-demo-dev-secret-INSECURE-2026-0123456789
# Secure flag of the session cookie: false only outside production (http://localhost).
SSO_DEMO_COOKIE_SECURE=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
