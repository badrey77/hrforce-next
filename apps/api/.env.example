# Copy to .env (git-ignored) and adjust. All variables are validated at boot (src/platform/config/env.schema.ts).
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Runtime connection: hrforce_app role (DML only, subject to RLS, not owner, no BYPASSRLS)
DATABASE_URL=postgres://hrforce_app:hrforce_app_dev@localhost:5432/hrforce
# Migration connection: hrforce_migrator role (owns the schema). Used by `npm run migrate -w @hrforce/api`.
MIGRATOR_DATABASE_URL=postgres://hrforce_migrator:hrforce_migrator_dev@localhost:5432/hrforce
DB_POOL_MAX=10

# At least 32 characters. Generate with: openssl rand -base64 48
COOKIE_SECRET=change-me-change-me-change-me-change-me

# Number of reverse-proxy hops to trust for X-Forwarded-* (0 = none)
TRUST_PROXY_HOPS=0
