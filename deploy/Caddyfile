# Edge proxy for staging (service `proxy` in compose.staging.yml; image caddy:2.10-alpine).
#  - automatic HTTPS (Let's Encrypt) for {$STAGING_DOMAIN}; HTTP → HTTPS redirect is automatic
#  - /api, /api/*, /oidc and /oidc/* → api:3000 (the NestJS API); everything else → web:8080 (static Angular build, SPA fallback)
#  - security headers on every response, API included
# Upstream names resolve on the compose-internal network only; neither api nor web publishes a port.
{
	email {$ACME_EMAIL}
}

{$STAGING_DOMAIN} {
	# Compression buffers responses, which would hold back Server-Sent Events: never compress the notification stream.
	@compressible not path /api/me/notifications/stream
	encode @compressible zstd gzip

	# Access log on stdout (docker compose logs proxy). /password/setup?token=… carries a live single-use token in
	# its query: drop it from the log. Cookie / Authorization headers are redacted by Caddy by default.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					# SSO (/oidc/*): an ID token sent back at logout, and the authorization code / state of a resume
					delete id_token_hint
					delete login_hint
					delete code
					delete state
				}
				# the provider's resume redirect carries the authorization code in its Location (as the API's own logs,
				# which redact res.headers.location)
				resp_headers>Location delete
			}
		}
	}

	header {
		# Removing a header makes Caddy apply the whole block lazily, i.e. these values also override anything
		# the upstreams send.
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow"
	}

	# Content-Security-Policy, by two mutually exclusive matchers (no ordering question between them):
	#  - employee-file downloads (docs/contracts/documents.md › Upload validation): uploaded bytes are never a page —
	#    the API's own `sandbox; default-src 'none'` is kept (and enforced here too);
	#  - the OpenID Connect provider (/oidc/*) is left out: its pages send their own CSP (a hashed inline script, and
#    form-action naming the connected app's origin for the logout redirect), which must reach the browser untouched;
#  - everything else: scripts only our own files (no inline script, no eval). Styles: 'unsafe-inline' is required
	#    because Angular injects component styles as <style> elements at runtime (no per-request nonce with a static
	#    server). Fonts are self-hosted (Cairo, Source Sans 3). The index.html build output must contain no inline
	#    <script> / on* handler: apps/web/Dockerfile fails the build otherwise (deploy/web/check-index-csp.mjs).
	# (employee files, and the candidate files of recruitment — HR route and the heads' /me route)
	@employeeFileContent path_regexp ^/api/(employees/[^/]+/files/[^/]+/content|recruitment/candidates/[^/]+/files/[^/]+/content|me/recruitment/applications/[^/]+/files/[^/]+/content)$
	@notEmployeeFileContent {
		not path_regexp ^/api/(employees/[^/]+/files/[^/]+/content|recruitment/candidates/[^/]+/files/[^/]+/content|me/recruitment/applications/[^/]+/files/[^/]+/content)$
		not path /oidc /oidc/*
	}
	header @employeeFileContent {
		Content-Security-Policy "sandbox; default-src 'none'"
		defer
	}
	header @notEmployeeFileContent {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		defer
	}

	@api path /api /api/*
	handle @api {
		# Defence in depth: the development identity headers never reach the API (DEV_AUTH is also refused in
		# production by the API's env validation).
		request_header -X-Dev-User-Id
		request_header -X-Dev-Company-Id
		# Employee-file uploads (POST /api/employees/:id/files): the API stops reading at EMPLOYEE_FILE_MAX_BYTES
		# (10 MB by default, at most 20 MB) and answers 422 too_large; the proxy refuses anything beyond 25 MB outright.
		# Candidate files (POST /api/recruitment/candidates/:id/files, docs/contracts/recruitment.md) follow the same rule.
		@employeeFileUpload path_regexp ^/api/(employees|recruitment/candidates)/[^/]+/files$
		request_body @employeeFileUpload {
			max_size 25MB
		}
		# Caddy replaces any client-sent X-Forwarded-For with the real client IP (no trusted_proxies configured),
		# so the API's TRUST_PROXY_HOPS=1 yields the true client address for the login throttle.
		reverse_proxy api:3000
	}

	# HRForce as an OpenID Connect provider (docs/contracts/sso.md): discovery, authorize, token, JWKS, userinfo and
	# logout are served by the API under the issuer ${WEB_BASE_URL}/oidc.
	@oidc path /oidc /oidc/*
	handle @oidc {
		request_header -X-Dev-User-Id
		request_header -X-Dev-Company-Id
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:8080
	}
}
