# Copy to .env (git-ignored) and adjust. All variables are validated at boot (src/platform/config/env.schema.ts).
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Runtime connection: hrforce_app role (DML only, subject to RLS, not owner, no BYPASSRLS)
DATABASE_URL=postgres://hrforce_app:hrforce_app_dev@localhost:5432/hrforce
# Migration connection: hrforce_migrator role (owns the schema). Used by `npm run migrate -w @hrforce/api`.
MIGRATOR_DATABASE_URL=postgres://hrforce_migrator:hrforce_migrator_dev@localhost:5432/hrforce
DB_POOL_MAX=10

# Background worker (npm run worker -w @hrforce/api → node dist/worker.js): hrforce_worker role (subject to RLS; each
# job sets its company). It reuses WEB_BASE_URL and the MAIL_* settings below. The API ignores these two.
WORKER_DATABASE_URL=postgres://hrforce_worker:hrforce_worker_dev@localhost:5432/hrforce
# Jobs run at the same time (1–32, default 4).
WORKER_CONCURRENCY=4

# At least 32 characters. Generate with: openssl rand -base64 48
COOKIE_SECRET=change-me-change-me-change-me-change-me

# Identity (docs/contracts/identity.md). Both ≥ 32 characters and different. Generate with: openssl rand -base64 48
# HS256 key of the access token (cookie hrf_at)
AUTH_ACCESS_SECRET=change-me-access-change-me-access-change-me
# HMAC key of the signed double-submit XSRF token (cookie XSRF-TOKEN)
AUTH_XSRF_SECRET=change-me-xsrf-change-me-xsrf-change-me-xsrf
# AES-256-GCM key of the users' TOTP secrets (two-step sign-in, docs/contracts/mfa.md): base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32. Required in production. Unset in development/test = a PUBLIC, INSECURE
# built-in key (warned at boot). Changing it makes every enrolled authenticator unusable (see README › Two-step sign-in).
# AUTH_MFA_KEY=
# HMAC key of the attendance check-in (docs/contracts/attendance.md, ADR 009): the kiosks' QR codes, the scan receipts
# and the per-browser device references. Base64 of exactly 32 bytes (openssl rand -base64 32). Required in production;
# unset in development/test = a PUBLIC, INSECURE built-in key (warned at boot).
# ATTENDANCE_KEY=
# SSO (docs/contracts/sso.md, ADR 007): AES-256-GCM key of the connected apps' client secrets and signing keys, and the
# provider's cookie-signing key. Base64 of exactly 32 bytes (openssl rand -base64 32). Required in production; unset in
# development/test = a PUBLIC, INSECURE built-in key (warned at boot; the seeded sso-demo secret is encrypted with it).
# OIDC_KEY=
# `Secure` flag on every cookie (default true). false is only accepted with NODE_ENV=development or test
# (needed for http://localhost).
COOKIE_SECURE=false
# Public URL of the web app, used in mailed links: ${WEB_BASE_URL}/password/setup?token=…
WEB_BASE_URL=http://localhost:4200

# Mail: smtp (nodemailer → SMTP_URL; Mailpit from docker-compose in development) or log (writes mails, links
# included, to the log at info — development/test only).
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="HRForce <no-reply@hrforce.local>"

# Number of reverse-proxy hops to trust for X-Forwarded-* (0 = none). Also decides the client IP used by the
# login throttle (auth.login_event.ip): set it to the real number of proxies in front of the API.
TRUST_PROXY_HOPS=0

# Development shortcut: every AUTHENTICATED caller holds every permission, ignoring roles and grants. Leave it
# commented out to use the real roles and grants from seed:dev. Only accepted with NODE_ENV=development or test
# (boot fails otherwise). Never in production.
# DEV_PERMISSIONS=allow_all

# Development identity: also trust X-Dev-User-Id / X-Dev-Company-Id headers (for curl/API tests; a valid session
# cookie wins). Only accepted with NODE_ENV=development or test (boot fails otherwise). Never in production.
DEV_AUTH=false
